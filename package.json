{
  "name": "dinopad",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas interativo mobile-first sobre a história da vida, fósseis, fauna e flora",
  "type": "module",
  "scripts": {
    "brand:build": "tsx scripts/brand/process-logo.ts",
    "brand:validate": "tsx scripts/brand/process-logo.ts --check",
    "dev": "vite",
    "build": "npm run content:validate && npm run content:build && tsc -b && vite build && tsx scripts/build-sw-manifest.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test tests/e2e/timeline.spec.ts tests/e2e/arvore.spec.ts tests/e2e/configuracoes.spec.ts tests/e2e/humanidade-biblioteca.spec.ts",
    "content:import": "tsx scripts/content/import.ts",
    "content:migrate-expansion": "tsx scripts/content/migrate-expansion-model.ts",
    "content:seed-meta72": "tsx scripts/content/seed-meta72.ts",
    "content:seed-humanidade": "tsx scripts/content/seed-humanidade.ts",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:media": "tsx scripts/content/media.ts",
    "content:media:audit": "tsx scripts/content/media-audit.ts",
    "content:approve-meta72": "tsx scripts/content/approve-meta72.ts",
    "content:build": "tsx scripts/content/build-index.ts",
    "content:report": "tsx scripts/content/report.ts",
    "check": "npm run brand:validate && npm run lint && npm run type-check && npm run test && npm run build"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "framer-motion": "^11.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
